module Benchmark {
    class Car {
        signals:
            Float lat;
            Float lon;
            Float speed;

        constraints:
            temporal_consistency_001 {
                if abs(
                    self.speed.last(default:0.0) -
                    self.speed.history(at:-8, default:0.0)
                ) > 1000000.0 {
                    alert! "Temporal consistency violation.";
                }
            }

            temporal_consistency_002 {
                if abs(
                    self.speed.last(default:0.0) -
                    self.speed.history(at:-8, default:0.0)
                ) > 1000000.0 {
                    alert! "Temporal consistency violation.";
                }
            }

            temporal_consistency_003 {
                if abs(
                    self.speed.last(default:0.0) -
                    self.speed.history(at:-8, default:0.0)
                ) > 1000000.0 {
                    alert! "Temporal consistency violation.";
                }
            }

            temporal_consistency_004 {
                if abs(
                    self.speed.last(default:0.0) -
                    self.speed.history(at:-8, default:0.0)
                ) > 1000000.0 {
                    alert! "Temporal consistency violation.";
                }
            }

            temporal_consistency_005 {
                if abs(
                    self.speed.last(default:0.0) -
                    self.speed.history(at:-8, default:0.0)
                ) > 1000000.0 {
                    alert! "Temporal consistency violation.";
                }
            }

            temporal_consistency_006 {
                if abs(
                    self.speed.last(default:0.0) -
                    self.speed.history(at:-8, default:0.0)
                ) > 1000000.0 {
                    alert! "Temporal consistency violation.";
                }
            }

            temporal_consistency_007 {
                if abs(
                    self.speed.last(default:0.0) -
                    self.speed.history(at:-8, default:0.0)
                ) > 1000000.0 {
                    alert! "Temporal consistency violation.";
                }
            }

            temporal_consistency_008 {
                if abs(
                    self.speed.last(default:0.0) -
                    self.speed.history(at:-8, default:0.0)
                ) > 1000000.0 {
                    alert! "Temporal consistency violation.";
                }
            }

    }
}

world Rq2Synthetic {
    use Benchmark;
    cars: Car[];

    constraints:
        pairwise_distance_001 @always {
            if exists c1 in cars, c2 in cars:
                c1.uid.last(default:-1) != c2.uid.last(default:-1) and
                is_close(
                    c1.lat.last(default:0.0),
                    c1.lon.last(default:0.0),
                    c2.lat.last(default:0.0),
                    c2.lon.last(default:0.0),
                    0.25
                ) {
                alert! "Pairwise safe-distance violation.";
            }
        }

        pairwise_distance_002 @always {
            if exists c1 in cars, c2 in cars:
                c1.uid.last(default:-1) != c2.uid.last(default:-1) and
                is_close(
                    c1.lat.last(default:0.0),
                    c1.lon.last(default:0.0),
                    c2.lat.last(default:0.0),
                    c2.lon.last(default:0.0),
                    0.25
                ) {
                alert! "Pairwise safe-distance violation.";
            }
        }

